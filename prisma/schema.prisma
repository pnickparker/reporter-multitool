generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  createdAt DateTime  @default(now())
  projects  Project[]

  driveConnection GoogleDriveConnection?
}

model GoogleDriveConnection {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  driveFolderId String
  connectedAt   DateTime @default(now())
}

model Project {
  id        String    @id @default(cuid())
  name      String
  notes     String?
  eventDate DateTime?
  venue     String?
  tags      String[]
  createdAt DateTime  @default(now())
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id])
  assets    Asset[]
}

enum AssetType {
  VIDEO
  AUDIO
  DOCUMENT
  NOTE
}

enum AssetStatus {
  UPLOADING
  TRANSCRIBING
  GENERATING
  READY
  ERROR
}

model Asset {
  id            String      @id @default(cuid())
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id])
  type          AssetType
  sourceFile    String
  /**
   * Seconds — from Drive's videoMediaMetadata when available (video only; Drive doesn't expose audio duration).
   */
  duration      Int?
  /**
   * Bytes — from Drive's file metadata, captured at finalize time to estimate processing time before attempting transcription. Assumes realistic reporter-clip sizes (well under 2GB); revisit the type if that ever stops holding.
   */
  fileSizeBytes Int?
  /// The file's MIME type as the browser reported it at upload — lets the page tell a photo (image/*) from a PDF among DOCUMENT assets without changing the AssetType enum, which the live site's older code couldn't read.
  mimeType      String?
  uploadedAt    DateTime    @default(now())
  /// When processing (transcription + AI steps) last started — lets the app tell "still working" from "cut off by the server's time limit." Null on older rows; uploadedAt stands in.
  processingStartedAt DateTime?
  /// Names the reporter gave the transcript's speakers, e.g. {"A": "Coach Smith"} — shown in place of "Speaker A". Cleared when the transcript is re-run (the letters may then mean different people). Null when none.
  speakerNames Json?
  status        AssetStatus @default(UPLOADING)
  errorMessage  String?

  transcript    Transcript?
  flaggedQuotes FlaggedQuote[]
  socialPosts   GeneratedSocialPost[]
}

model Transcript {
  id       String @id @default(cuid())
  assetId  String @unique
  asset    Asset  @relation(fields: [assetId], references: [id])
  text     String
  segments Json
}

model FlaggedQuote {
  id              String @id @default(cuid())
  assetId         String
  asset           Asset  @relation(fields: [assetId], references: [id])
  timestamp       Float
  /// When the quote ends (seconds into the recording), from per-word timings — lets the player play just the quote. Null on older quotes.
  endTimestamp    Float?
  text            String
  reason          String
  engagementScore Int    @default(0)
  /// How the quote was checked against the transcript: "exact" (the words as spoken) or "adjusted" (the AI's version skipped words, so the exact transcript wording was used instead). Null on quotes saved before this check existed.
  verification    String?

  socialPosts GeneratedSocialPost[]
}

model GeneratedSocialPost {
  id        String        @id @default(cuid())
  assetId   String
  asset     Asset         @relation(fields: [assetId], references: [id])
  quoteId   String?
  quote     FlaggedQuote? @relation(fields: [quoteId], references: [id])
  platform  String
  copy      String
  /// "ok" when every quoted passage in the draft appears in the transcript, "check" when one doesn't (the reporter should look before posting). Null when the draft quotes nothing or predates this check.
  quoteCheck String?
  createdAt DateTime      @default(now())
}

/// What each processing step cost, recorded per recording so pricing can rest on measured numbers. Holds no recording content.
/// Deliberately has no link to Asset: the cost was incurred even if the recording is later deleted.
model UsageRecord {
  id           String   @id @default(cuid())
  assetId      String
  /// "transcription" | "quotes" | "posts"
  kind         String
  model        String
  inputTokens  Int?
  outputTokens Int?
  audioSeconds Float?
  /// Estimated at the list prices in src/lib/usage/pricing.ts when the step ran.
  costUsd      Float
  createdAt    DateTime @default(now())

  @@index([assetId])
  @@index([createdAt])
}

/// A record of alert emails (about recordings that failed), so the same problem isn't sent twice and a burst can't flood an inbox.
model AlertLog {
  id        String   @id @default(cuid())
  key       String
  subject   String
  delivered Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

